# ============================================================================
# CoalGov AI - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Always include an explicit database name. Do not leave the name off the end of
# an Atlas connection string: it silently defaults to the shared `test`
# database, where `npm run seed` would delete unrelated collections.
#
# Local:  mongodb://localhost:27017/coalgov
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/coalgov?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/coalgov

# --- Cache / sessions -------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Set true only for multi-instance deployments; requires a reachable Redis.
# Left false, the app uses an in-memory session store (fine for one instance).
USE_REDIS_SESSION=false

# --- Session ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- AI (Groq) --------------------------------------------------------------
# Server-side only. Never expose this key to browser JavaScript.
GROQ_API_KEY=
# Optional override. The service automatically falls back through
# openai/gpt-oss-120b -> openai/gpt-oss-20b -> groq/compound-mini when a model
# is unavailable for the key. With no key, the app runs in labelled DEMO MODE.
GROQ_MODEL=openai/gpt-oss-120b

# --- Application ------------------------------------------------------------
APP_NAME=CoalGov AI
DEMO_MODE=true

# --- Development only -------------------------------------------------------
# Disables rate limiting so automated checks (scripts/smokeTest.js) can log in
# once per role. Never enable in production.
DISABLE_RATE_LIMIT=false
